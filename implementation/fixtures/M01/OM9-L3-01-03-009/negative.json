      "call": "Extension::new(1, \"[1,2]\")",
      "id": "payload-not-object",
      "expect": {
        "error": "Invalid(\"extension payload\")"
      }
    },
    {
      "call": "Extension::new(1, \"{\")",
      "id": "payload-malformed",
      "expect": {
        "error": "Invalid(\"extension payload\")"
      }
    },
    {
      "call": "Extension::new(1, \"{}\")",
      "id": "empty-payload",
      "expect": {
        "error": "Invalid(\"empty extension payload\")"
      }
    },
    {
      "call": "Extension::new(0, \"{...}\")",
      "id": "version-zero",
      "expect": {
        "error": "Invalid(\"extension version\")"
      }
    },
    {
      "call": "slot \"Gem\"",
