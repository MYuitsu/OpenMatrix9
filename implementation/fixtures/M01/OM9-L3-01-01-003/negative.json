{
  "schema": "om9.m01.fixture.v1",
  "oracle_schema": "om9.m01.oracle.v1.5",
  "oracle_schema_note": "no local definition of om9.m01.oracle.v1.5 exists in this repository; the string is carried as a field only",
  "l3": "OM9-L3-01-01-003",
  "l4": "OM9-L4-01-01-003-02",
  "case": "reorder-collapse-float-panels-negative",
  "contract": "implementation/design/M01/OM9-L3-01-01-003/api.md",
  "user_decisions": ".agents/tasks/m01-l3-003-panels/user-decisions.md",
  "source": "authored for the OM9 standalone shell; numbers are hand-computed from the documented constants and the D1 work-area formula, never copied from program output",
  "status": "RUNTIME_DRIVEN_BY_TEST",
  "negative_oracle": "Dragging panel outside screen can be recovered/reset",
  "boundary": "Recovery here is clamp/snap-back only; Reset Menus belongs to L3-004.",
  "rect_format": "[x, y, width, height] in logical window points, origin top-left",
  "non_finite_tokens": "JSON cannot carry NaN/inf, so the strings \"NaN\", \"inf\" and \"-inf\" stand for those f32 values",
  "constants": {
    "work_area_formula": "[8, 29, W - 16, H - 57]",
    "work_area_1600x1000": [8, 29, 1584, 943],
    "work_area_1280x720": [8, 29, 1264, 663],
    "float_drop_rect": "[p.x - 150, p.y - 7, 300, 240]",
    "float_min": [180, 120]
  },
  "every_error_case_expects": {
    "dock_layout_to_json_before_equals_after": true,
    "visible_status": "Warning (Info only for DragCancelled Escape), unless an unacknowledged Error is on the status line, then CMD history only",
    "cmd_history_line": "Menus: <error text>",
    "document_and_undo_unchanged": true,
    "no_panic": true
  },
  "cases": [
    { "id": "N1-drop-beyond-the-right-edge", "window": [1600, 1000], "drag": "display", "release_pointer": [1700, 500],
      "expect": { "target": "FloatOutside", "raw_rect": [1550, 493, 300, 240], "float": [1292, 493, 300, 240],
        "notes": ["Recovered", "OutsideMainWindow"], "status_kind": "Warning",
        "status": "Display cannot float outside the main window; placed inside it",
        "cmd_history_contains": ["Display was moved back inside the window", "Display cannot float outside the main window; placed inside it"] } },
    { "id": "N2-drop-beyond-the-left-edge", "window": [1600, 1000], "drag": "display", "release_pointer": [-100, 500],
      "expect": { "target": "FloatOutside", "raw_rect": [-250, 493, 300, 240], "float": [8, 493, 300, 240], "notes": ["Recovered", "OutsideMainWindow"] } },
    { "id": "N3-drop-beyond-the-top-edge", "window": [1600, 1000], "drag": "display", "release_pointer": [700, -50],
      "expect": { "target": "FloatOutside", "raw_rect": [550, -57, 300, 240], "float": [550, 29, 300, 240], "notes": ["Recovered", "OutsideMainWindow"] } },
    { "id": "N4-drop-beyond-the-bottom-edge", "window": [1600, 1000], "drag": "display", "release_pointer": [700, 1100],
      "expect": { "target": "FloatOutside", "raw_rect": [550, 1093, 300, 240], "float": [550, 732, 300, 240], "notes": ["Recovered", "OutsideMainWindow"] } },
    { "id": "N5-drop-in-a-view-near-the-bottom-right-corner", "window": [1600, 1000], "drag": "display", "release_pointer": [1540, 970],
      "precondition": "pointer inside SideView [951, 580, 649, 400] and outside the right drop strip [1552, 178, 48, 802]",
      "expect": { "target": "Float", "raw_rect": [1390, 963, 300, 240], "float": [1292, 732, 300, 240], "notes": ["Recovered"],
        "status": "Display was moved back inside the window" } },
    { "id": "N6-api-float-huge-rect", "window": [1600, 1000], "op": { "op": "Float", "section": "display", "rect": [100000, 100000, 100000, 100000], "origin": "Api" },
      "expect": { "float": [8, 29, 1584, 943], "notes": ["Recovered"] } },
    { "id": "N7-api-float-far-negative-origin", "window": [1600, 1000], "op": { "op": "Float", "section": "display", "rect": [-5000, -5000, 300, 240], "origin": "Api" },
      "expect": { "float": [8, 29, 300, 240], "notes": ["Recovered"] } },
    { "id": "N8-api-float-small-positive-size-is-normalised", "window": [1600, 1000], "op": { "op": "Float", "section": "display", "rect": [100, 100, 10, 10], "origin": "Api" },
      "expect": { "float": [100, 100, 180, 120], "notes": ["Recovered"] } },
    { "id": "N9-api-float-nan-x", "window": [1600, 1000], "op": { "op": "Float", "section": "display", "rect": ["NaN", 100, 300, 240] },
      "expect": { "result": "error", "error": "InvalidRect", "status": "Display: the floating rectangle is not valid", "layout_unchanged": true } },
    { "id": "N10-api-float-infinite-width", "window": [1600, 1000], "op": { "op": "Float", "section": "display", "rect": [100, 100, "inf", 240] },
      "expect": { "result": "error", "error": "InvalidRect", "layout_unchanged": true } },
    { "id": "N11-api-float-zero-width", "window": [1600, 1000], "op": { "op": "Float", "section": "display", "rect": [100, 100, 0, 240] },
      "expect": { "result": "error", "error": "InvalidRect", "layout_unchanged": true } },
    { "id": "N12-api-float-negative-height", "window": [1600, 1000], "op": { "op": "Float", "section": "display", "rect": [100, 100, 300, -10] },
      "expect": { "result": "error", "error": "InvalidRect", "layout_unchanged": true } },
    { "id": "N13-readback-nan-from-a-floating-window", "op": { "op": "SetFloatRect", "section": "display", "rect": [100, "NaN", 300, 240] },
      "expect": { "result": "error", "error": "InvalidRect", "stored_float_unchanged": true } },
    { "id": "N14-window-shrink-recovers-a-floating-menu",
      "setup": { "window": [1600, 1000], "op": { "op": "Float", "section": "display", "rect": [1200, 600, 300, 240], "origin": "Api" }, "notes_expected": [] },
      "resize_to": [1280, 720],
      "expect": { "float": [972, 452, 300, 240], "diagnostic": "Display was moved back inside the window", "status_kind": "Warning",
        "cmd_history_contains": ["Display was moved back inside the window"], "dock_dirty": true, "next_frame_uses_current_pos": [972, 452] } },
    { "id": "N15-shrink-below-the-plan-floor-does-not-rewrite-layout",
      "setup": { "window": [1600, 1000], "op": { "op": "Float", "section": "display", "rect": [1200, 600, 300, 240], "origin": "Api" } },
      "resize_to": [500, 250],
      "expect": { "region_error": "present", "float": [1200, 600, 300, 240], "dock_dirty_unchanged": true, "float_readback_skipped": true,
        "float_op_during_error": { "result": "error", "error": "LayoutBlocked" } } },
    { "id": "N16-work-area-from-an-invalid-window", "windows": [[0, 0], [-10, 500], ["NaN", 500], [800, "inf"], [1000000, 500], [150, 150]],
      "expect": { "result": "error", "error": "InvalidWindow", "work_area": null, "float_op": "NoWorkArea" } },
    { "id": "N17-float-before-the-first-frame", "frames_before": 0, "op": "float_menu_section(display, [600, 300, 320, 240])",
      "expect": { "returns": false, "error": "NoWorkArea", "layout_unchanged": true } },
    { "id": "N18-drop-over-the-toolbar-cancels", "window": [1600, 1000], "drag": "display", "release_pointer": [800, 140],
      "precondition": "pointer inside toolbar [300, 111, 1300, 67]",
      "expect": { "target": { "Cancel": { "reason": "NoTarget" } }, "error": "DragCancelled", "status_kind": "Warning",
        "status": "Display drag cancelled: not over a menu column or viewport", "layout_unchanged": true, "preview_indicator": null } },
    { "id": "N19-escape-cancels-a-drag-and-keeps-the-cmd-draft",
      "setup": "type Point, Enter, then 1,2, (command running, draft '1,2,')",
      "steps": ["press DISPLAY bar", "move into LookingDown (preview Float present)", "press Escape", "release inside LookingDown"],
      "expect": { "error": "DragCancelled", "reason": "Escape", "status_kind": "Info", "status": "Display drag cancelled (Esc)",
        "draft": "1,2,", "controller_is_running": true, "entities": 0, "undo_len": 0, "drop_preview_after_escape": null,
        "release_applies_nothing": true, "layout_unchanged": true } },
    { "id": "N20-pointer-lost-at-release", "unit_only": true, "resolve_drop_pointer": null,
      "expect": { "target": { "Cancel": { "reason": "PointerLost" } }, "layout_unchanged": true } },
    { "id": "N21-builders-bar-click-is-refused", "path": "mouse click on the BUILDERS title bar",
      "expect": { "error": "NotPermitted", "status": "Builders is reserved for builder tools and cannot be rolled up, moved or floated",
        "builder-slot.collapsed": false, "drag_cannot_start": true, "layout_unchanged": true } },
    { "id": "N22-builders-api-operations-are-refused",
      "ops": [{ "op": "Move", "section": "builder-slot", "delta": -1 }, { "op": "Dock", "section": "builder-slot", "side": "right" },
              { "op": "Float", "section": "builder-slot", "rect": [100, 100, 300, 240] }],
      "expect": { "each": { "error": "NotPermitted", "layout_unchanged": true } } },
    { "id": "N23-reorder-a-floating-menu",
      "setup": { "op": "Float", "section": "display", "rect": [550, 393, 300, 240] }, "op": { "op": "Move", "section": "display", "delta": 1 },
      "expect": { "error": "NotDocked", "wrapper_returns": false, "status": "Display is floating; dock it before reordering" } },
    { "id": "N24-float-an-already-floating-menu",
      "setup": { "op": "Float", "section": "display", "rect": [550, 393, 300, 240] }, "op": "float_menu_section(display, [600, 300, 320, 240])",
      "expect": { "error": "AlreadyFloating", "wrapper_returns": false, "status": "Display is already floating", "float": [550, 393, 300, 240] } },
    { "id": "N25-no-op-moves-are-reported-not-silent",
      "ops": [{ "op": "Move", "section": "icon-history", "delta": -1 }, { "op": "Move", "section": "projects", "delta": 0 },
              { "op": "Dock", "section": "layers", "side": "left" }],
      "expect": { "each": { "error": "AlreadyThere", "status_kind": "Warning", "layout_unchanged": true } } },
    { "id": "N26-dock-to-a-non-column-side", "op": "dock_menu_section(snaps, DockSide::Top)", "also": ["Bottom", "Floating"],
      "expect": { "error": "InvalidTarget", "wrapper_returns": false, "status": "menus dock only to the left or right column", "layout_unchanged": true } },
    { "id": "N27-unknown-section-key-at-the-audit-boundary", "key": "left-dock.legacy",
      "expect": { "error": "UnknownSection", "status": "menu section 'left-dock.legacy' is not recognized", "layout_unchanged": true } },
    { "id": "N28-hidden-section-cannot-be-moved", "setup": "set_section_visible(info-settings, false)",
      "ops": [{ "op": "Move", "section": "info-settings", "delta": 1 }, { "op": "Float", "section": "info-settings", "rect": [100, 100, 300, 240] }],
      "expect": { "each": { "error": "Hidden", "layout_unchanged": true } } },
    { "id": "N29-drag-in-progress-across-reset-reload-and-hide",
      "steps": ["press PROJECTS bar and move 10 px", "View ▸ Matrix Menus ▸ Reset Menus", "release over LookingDown"],
      "variants": ["Reload Menus instead of Reset", "set_section_visible(projects, false) instead of Reset"],
      "expect": { "section_drag_after_reset": null, "drop_preview_after_reset": null, "cmd_history_contains": "Projects drag cancelled: menus were reset",
        "release_applies_nothing": true, "no_panic": true } },
    { "id": "N30-unacknowledged-error-is-not-hidden-by-panel-messages",
      "setup": "type NotACommand, Enter (status Error)", "op": "drag PROJECTS onto the DISPLAY bar",
      "expect": { "status_kind": "Error", "status_message_unchanged": true, "cmd_history_contains": "Projects moved to menu position 3" } },
    { "id": "N31-layers-is-never-moved-by-the-audit-hook", "decision": "D6 L5",
      "env": { "OM9_UI_AUDIT_RIGHT_DOCK": "1" },
      "expect": { "right_order": ["projects"], "layers.dock": "left", "layers_directly_below_info_settings": true, "right_dock_shown_at_1600x1000": true } },
    { "id": "N32-layers-docked-right-then-narrow-window-is-not-auto-moved", "decision": "D6 L4",
      "setup": { "window": [1600, 1000], "op": { "op": "Dock", "section": "layers", "side": "right" } }, "resize_to": [1000, 720],
      "expect": { "notes": ["RightDockYielded (L3-002)"], "layers.dock": "right", "dock_left_restores": { "left_order_index": 5 } } },
    { "id": "N33-randomized-operation-sweep",
      "generator": "seeded xorshift64, seed 0x0E9_003, 2000 ops; sections incl. builder-slot and hidden ones; rects incl. NaN, inf, 0, -1, 1e6; deltas incl. i32::MIN and i32::MAX; windows incl. invalid ones",
      "expect": { "no_panic": true, "every_section_exactly_once": true, "orders_dense_per_column": true,
        "every_floating_rect_finite_and_inside_last_valid_work_area": true, "every_error_leaves_to_json_unchanged": true } },
    { "id": "N34-source-scan-single-door",
      "files": ["src/ui.rs", "src/ui/chrome.rs", "src/ui/panel_audit.rs"],
      "forbidden_calls": [".toggle_section(", ".move_section(", ".dock_section(", ".float_section(", ".place_section(", ".set_section_collapsed("],
      "expect": { "occurrences_outside_comments": 0 } }
  ]
}
