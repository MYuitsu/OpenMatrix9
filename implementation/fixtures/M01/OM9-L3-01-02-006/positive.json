{
  "schema": "om9.m01.fixture.v1",
  "l3": "OM9-L3-01-02-006",
  "l4": "OM9-L4-01-02-006-02",
  "case": "atomic-command-transactions-positive",
  "positive_oracle": "One UI action creates one transaction and one revision even with multiple objects",
  "cases": [
    {
      "id": "T1-one-completed-command-is-one-journal-entry",
      "sequence": [
        "dispatch LINE",
        "point 0,0,0",
        "point 10,0,0"
      ],
      "expect": {
        "entities": 1,
        "undo_entries": 1,
        "redo_entries": 0
      }
    },
    {
      "id": "T2-a-second-command-adds-exactly-one-more",
      "sequence": [
        "LINE",
        "LINE"
      ],
      "expect": {
        "entities": 2,
        "undo_entries": 2
      }
    },
    {
      "id": "T3-the-document-identity-token-does-not-move-on-an-edit",
      "expect": {
        "context_revision_unchanged_by_an_edit": true,
        "detail": "context_revision is the document's identity token; the per-action counter is the journal/epoch"
      }
    }
  ]
}
