      "action": "dispatch POINT during LINE",
      "expect": {
        "error": "Busy",
        "entities_unchanged": true,
        "undo_unchanged": true
      }
    },
    {
      "id": "U3-a-cancelled-command-writes-nothing",
      "action": "Escape after the first point",
      "expect": {
        "entities_unchanged": true,
        "undo_unchanged": true,
        "phase": "Idle"
      }
    },
    {
      "id": "U4-a-stale-session-writes-nothing",
      "action": "switch the active view after the first point, then click",
      "expect": {
        "refused": true,
        "entities_unchanged": true,
        "undo_unchanged": true
      }
