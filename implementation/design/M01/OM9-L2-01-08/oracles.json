    "OM9-L3-01-08-007": {
      "positive": [
        { "id": "world-identity", "call": "resolve(World(WorldPoint(1,2,3)), None)", "expect": { "xyz": [1, 2, 3] } },
        { "id": "local-two-frames", "frames": { "world_xy": "CPlane::world_xy()", "shifted": "CPlane::new([10,20,30],[0,1,0],[0,0,1])" }, "call": "resolve(Local(LocalPoint(1,2,3)), Some(frame))", "expect": { "world_xy": [1, 2, 3], "shifted": [13, 21, 32] } },
