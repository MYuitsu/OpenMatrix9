        { "id": "negative-absolute", "call": "Tolerance::try_new(-0.001, 1e-6, 0.0)", "expect": { "error": "Invalid(\"absolute tolerance\")" } },
        { "id": "negative-relative", "call": "Tolerance::try_new(0.001, -1e-6, 0.0)", "expect": { "error": "Invalid(\"relative tolerance\")" } },
        { "id": "nan-angular", "call": "Tolerance::try_new(0.001, 0.0, \"NaN\")", "expect": { "error": "Invalid(\"angular tolerance\")" } },
        { "id": "invalid-in-mutation", "call": "prepare Mutation::Tolerance with Tolerance {absolute_mm: 0.0, ..} built by struct literal", "expect": { "error": "Invalid(\"effective tolerance\")", "coordinator_snapshot_unchanged": true } },
        { "id": "stale-revision", "call": "prepare Mutation::Tolerance { expected_revision: revision - 1 }", "expect": { "error": "Stale(\"document tolerance revision\")", "coordinator_snapshot_unchanged": true } },
        { "id": "feature-at-or-below-tolerance", "call": "t.admit_feature(LengthMm::try_new(0.001)?)", "expect": { "error": "Invalid(\"feature at or below document absolute tolerance\")" } },
        { "id": "kernel-pass-through", "status": "NEEDS_USER_M00_DECISION (OCCT not approved; OM9-L2-01-05 absent)", "expect": "only Document::effective_tolerance() is asserted" }
      ]
    },
