  "oracle_schema_note": "no local definition of om9.m01.oracle.v1.5 exists in this repository; the string is carried as a field only",
  "l2": "OM9-L2-01-08",
  "source": "authored for the OM9 standalone backend from the l3.json positive/negative oracles; every expected value is hand-derived (unit factors from geometry.rs:46-55, IEEE-754 doubles), NOT copied from program output",
  "non_finite_tokens": "JSON cannot carry NaN/inf; the strings \"NaN\", \"inf\", \"-inf\" stand for those f64 values",
  "status": "RUNTIME_DRIVEN_BY_TEST (to be split into implementation/fixtures/M01/<L3>/positive.json|negative.json at L4-02 if the loop prefers per-L3 files)",
  "l3": {
    "OM9-L3-01-08-001": {
      "positive": [
        { "id": "length-2.5mm", "call": "LengthMm::try_new(2.5)", "expect": { "ok": true, "mm": 2.5, "json": "{\"mm\":2.5}", "reload_equal": true } },
        { "id": "inch-to-mm", "call": "LengthMm::from_unit(2.0, Unit::Inch)", "expect": { "ok": true, "mm": 50.8 } },
        { "id": "parse-suffix", "call": "LengthMm::parse(\"0.5 cm\", Unit::Millimeter)", "expect": { "ok": true, "mm": 5.0 } },
        { "id": "parse-default-unit", "call": "LengthMm::parse(\"2\", Unit::Inch)", "expect": { "ok": true, "mm": 50.8 } }
      ],
      "negative": [
        { "id": "nan", "call": "LengthMm::try_new(\"NaN\")", "expect": { "error": "UnitError::NonFinite" } },
        { "id": "inf", "call": "LengthMm::try_new(\"inf\")", "expect": { "error": "UnitError::NonFinite" } },
        { "id": "overflow-conversion", "call": "LengthMm::from_unit(f64::MAX, Unit::Inch)", "expect": { "error": "UnitError::NonFinite" } },
        { "id": "unsupported-unit", "call": "Unit::parse(\"yd\")", "expect": { "error": "UnitError::UnsupportedUnit", "core_error": "Error::Unsupported" } },
        { "id": "bare-json", "call": "serde_json::from_str::<LengthMm>(\"2.5\")", "expect": { "error": "deserialize" } },
        { "id": "document-unchanged", "call": "Mutation::Insert with Point built from a NaN LengthMm is impossible; CMD 'NaN,0,0' during Point", "expect": { "error": "Invalid(\"length conversion\")", "coordinator_snapshot_unchanged": true } }
      ]
    },
    "OM9-L3-01-08-002": {
      "positive": [
        { "id": "180deg-is-pi", "call": "AngleDeg::try_new(180.0)?.to_radians().rad()", "expect": { "near": 3.141592653589793, "abs_tol": 8.9e-16 } },
        { "id": "pi-back-to-180", "call": "AngleRad::try_new(PI)?.to_degrees()?.deg()", "expect": { "near": 180.0, "abs_tol": 1e-12 } },
        { "id": "parse-deg", "call": "AngleDeg::parse(\"90deg\")", "expect": { "deg": 90.0 } },
        { "id": "parse-rad-explicit", "call": "AngleDeg::parse(\"3.141592653589793rad\")", "expect": { "near": 180.0, "abs_tol": 1e-12 } },
        { "id": "json-tag", "call": "serde_json::to_string(&AngleDeg::try_new(45.0)?)", "expect": { "json": "{\"deg\":45.0}" } }
      ],
      "negative": [
        { "id": "nan", "call": "AngleDeg::try_new(\"NaN\")", "expect": { "error": "UnitError::NonFinite" } },
        { "id": "very-large", "call": "AngleDeg::try_new(1.0e7)", "expect": { "error": "UnitError::OutOfRange", "limit": 1.0e6 } },
        { "id": "radians-labelled-as-degrees", "call": "serde_json::from_str::<AngleDeg>(\"{\\\"rad\\\":1.5707963267948966}\")", "expect": { "error": "deserialize (unknown field rad)" } },
        { "id": "unknown-angle-unit", "call": "AngleDeg::parse(\"90grad\")", "expect": { "error": "UnitError::UnsupportedUnit" } }
      ]
    },
    "OM9-L3-01-08-003": {
      "positive": [
        { "id": "set-document-tolerance", "call": "commit Mutation::Tolerance { tolerance: Tolerance::try_new(0.001, 1e-6, 0.0174532925199433)? }", "expect": { "undo_len_delta": 1, "revision_delta": 1, "effective_tolerance.absolute_mm": 0.001, "effective_tolerance.relative": 1e-6, "context_revision_delta": 0 } },
        { "id": "undo-restores-unset", "call": "undo()", "expect": { "effective_tolerance": "Err(Missing(\"document tolerance\"))" } },
        { "id": "feature-above-tolerance", "call": "t.admit_feature(LengthMm::try_new(0.002)?)", "expect": { "ok": true } }
      ],
      "negative": [
