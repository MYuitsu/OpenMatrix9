      "positive": [
        { "id": "line-save", "document": "Curve::Line {start [0,0,0], end [12,6,0], domain [0, 12f64.hypot(6.)]}", "call": "Archive::save + Archive::open", "expect": { "ok": true, "reopened_entity_equal": true, "domain_end_bits": "12f64.hypot(6.).to_bits()" } },
        { "id": "params-roundtrip", "recipe_parameters": { "Length": { "mm": 1.234 }, "Angle": { "deg": 45 } }, "call": "Archive::encode/decode of a Detached recipe carrying Value::length(1.234mm) and Value::angle(45deg)", "expect": { "kind_preserved": true, "value_bits_equal": true } },
        { "id": "computed-length-json", "call": "serde_json round-trip of Value::length(LengthMm::try_new(12f64.hypot(6.)))", "expect": { "bits_equal": true } }
      ],
      "negative": [
        { "id": "missing-unit", "json": "{\"Number\": 1.234}", "call": "decode Value then OptionDomain::Number{Length}.check", "expect": { "error": "Invalid(\"option unit/dimension\")" } },
        { "id": "missing-page-unit", "call": "decode archive metadata without page_unit", "expect": { "error": "Invalid(\"typed document metadata/schema\")" } },
        { "id": "wrong-version", "call": "decode container with version 5", "expect": { "error": "Unsupported(\"OM9 schema version; no implicit migration\")" } }
