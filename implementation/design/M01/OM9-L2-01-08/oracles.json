        { "id": "step-zero", "domain": { "step": 0 }, "call": "OptionDomain::validate", "expect": { "error": "Invalid(\"numeric option domain\")" } },
        { "id": "min-greater-than-max", "domain": { "min": 10, "max": 1 }, "call": "OptionDomain::validate", "expect": { "error": "Invalid(\"numeric option domain\")" } },
        { "id": "state-unchanged", "call": "request::admit with an invalid domain or value", "expect": { "world_validate_equal_before_after": true } }
