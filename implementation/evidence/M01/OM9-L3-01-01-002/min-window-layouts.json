  "threshold_rationale": {
    "viewport_width_formula": "pure planner, default rails 300 + 300, gap 2: (W - 602) / 2",
    "at_1200": 299,
    "at_old_915": 156.5,
    "reasoning": "A viewport needs about 300 pt to stay useful. 1200 gives 299 pt (frame measures ~304 because egui rails are ~295 after margins). The old 915 rule left ~157 pt. 1200 is below the supported minimum 1280, so the dock shows at every supported size on a normal screen and yields on capped high-DPI laptop screens (1366x768 at 125%/150%).",
    "sweep": "first_dock_width=1200 height=800 layers_docked_right=true"
  },
  "layouts_note": "pure = compute_regions with the default layout and Layers docked right (hand-computed, asserted exactly); frame = the real MatrixApp::show frame under headless egui (rails measured after egui margins, within 8 pt of pure). DPI rows are logical points of a SIMULATED scale.",
