  "unrelated_work_needed_to_run_the_checks": {
    "file": "crates/om9-core/src/associative.rs",
    "function": "references_usage",
    "problem": "The uncommitted associative-history work in om9-core charged a BTree node for the empty `HistoryGraph::references` table in Document::validate, while Document::storage_usage_internal charges nothing for an empty optional table. The 1888-byte disagreement tripped debug_assert_eq!(total, storage) on every commit, which made every commit-path test in the workspace fail (om9-core gumball: 13 passed, 2 failed; the same two failures appeared at HEAD only with that working-tree change present).",
    "fix": "Return Usage::default() for an empty reference table, matching the documented convention.",
    "verified": "cargo test -p om9-core --test gumball -> 15 passed; 0 failed"
  },
  "manual_gate": "M03-UI_PENDING",
