L14: let libdir = env::var("OCCT_LIB_DIR").unwrap_or_else(|_| "/usr/lib".into());
L17: // same compiler that built OCCT. On Windows that is MSVC - the mainstream target for Rust there, and
L28: // explicitly; where they are defined anyway the define is harmless. Without it the OCCT headers do not
