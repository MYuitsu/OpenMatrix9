  "status": "AUTOMATED_TARGET_VALIDATED_MANUAL_UI_PENDING",
  "summary": "Audited the existing standalone picking/selection/Gumball implementation against all eight L3 oracles. No L3 feature surface was missing. One real defect was found and fixed: Scene::pick_all applied the nearest-only depth early-out, so a farther object on the same ray could disappear from the disambiguation popup depending on spatial-index order.",
  "audit": {
    "existing_implementation": true,
    "l3_count": 8,
    "missing_feature_code": [],
    "new_feature_code_required": false,
    "bug_fixed": "crates/om9-scene/src/picking.rs: the depth early-out now applies only when nearest_only is true; pick_all keeps every distinct object under the pointer, nearest first.",
    "regression": "crates/om9-scene/tests/acceptance_l2_01_07.rs::two_objects_on_one_ray_are_both_candidates_in_every_publication"
  },
  "code_changes": [
    "crates/om9-scene/src/picking.rs: guard the sphere-depth early-out with nearest_only",
    "crates/om9-scene/tests/acceptance_l2_01_07.rs: 32-publication candidate regression"
  ],
