+pub(crate) fn publish(result: Result<Spline, String>) -> bool {
+    let Ok(mut s) = state().lock() else {
+        return false;
+    };
+    match result {
+        Ok(curve) => {
+            s.curve = Some(curve);
+            s.message.clear();
+            true
+        }
+        Err(e) => {
+            s.curve = None;
+            s.message = e;
+            false
+        }
+    }
