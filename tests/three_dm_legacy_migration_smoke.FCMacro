        rationalDoc=App.newDocument('PristineLegacyRational');rationalSource=Path(tempfile.gettempdir())/'om9-shared-rational-curve.3dm';rationalRoots=ThreeDm.import_file(str(rationalSource),rationalDoc,mode='preserve');rationalOwner=rationalRoots[0].OM9ArchiveOwner
        rationalCanonical=next(o.LinkedObject for o in rationalDoc.Objects if getattr(o,'OM9DefinitionMemberProxy',False));rationalRecord=json.loads(rationalCanonical.OM9SourceRecord)
        for o in rationalDoc.Objects:
