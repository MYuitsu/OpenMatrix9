                      normalizer in group_copy.Group and bridge in group_copy.Group and bridge_is_durable(bridge,normalizer,grouped_occurrence) and
                      grouped_occurrence.getParentGeoFeatureGroup()==copied_root and grouped_occurrence.Visibility and same_shape(world_shape(grouped_occurrence),baseline_occurrence))
            created={obj.Name for obj in doc.Objects}-names;copy_names=(group_copy.Name,box_copy.Name,cylinder_copy.Name)
            doc.undo();doc.recompute();ui.settle()
            check('Alt group Undo removes only copied hierarchy and graphs',all(doc.getObject(name) is None for name in created) and copied_root.Group==original_members)
            doc.redo();doc.recompute();ui.settle();group_copy,box_copy,cylinder_copy=[doc.getObject(name) for name in copy_names]
            check('Alt group Redo restores private ownership and exact affine geometry',box_copy in group_copy.Group and cylinder_copy in group_copy.Group and
                  same_shape(world_shape(box_copy),baseline_box.transformGeometry(group_matrix)) and same_shape(world_shape(cylinder_copy),baseline_cylinder.transformGeometry(group_matrix)))
            for original,output in ((grouped_box,box_copy),(grouped_cylinder,cylinder_copy)):
                manifest.append({'source':original.Name,'output':output.Name,'matrix':list(group_matrix.A)})
            if grouped_occurrence is not None:
                manifest.append({'source':grouped_occurrence.Name,'output':result_for(doc,grouped_occurrence).Name,'matrix':list(group_matrix.A)})
        # Body is one result owner, rather than its Tip and Body being scaled
        # twice. Native Move and Alt Move keep the Tip's private ownership.
        body=doc.addObject('PartDesign::Body','NativeBody');tip=body.newObject('PartDesign::AdditiveBox','NativeBodyTip')
        tip.Length=3;tip.Width=4;tip.Height=5;doc.recompute();body.Visibility=True
        # A native Body-internal selection path is distinct from its final
        # result or a face token on that result. Reject it at capture without
        # creating a gesture or a transaction, then restore Body selection.
        body_internal_before=(set(obj.Name for obj in doc.Objects),doc.UndoCount,doc.RedoCount,body.Placement,tip.Placement,body.Tip)
        ui.select(tip);body_internal_state=native.gumballState();body_internal_selection=Gui.Selection.getSelectionEx(doc.Name,0)
        report['body_internal_selection']={'state':body_internal_state,
              'no_resolve':[{'object':entry.ObjectName,'subnames':list(entry.SubElementNames)} for entry in body_internal_selection]}
        check('Body internal child path rejects before a transaction and requests its native final result',len(body_internal_selection)==1 and
              body_internal_selection[0].Object==body and list(body_internal_selection[0].SubElementNames)==[tip.Name+'.'] and
              'UnsupportedOwner' in body_internal_state['unresolved'] and 'Body final result' in body_internal_state['unresolved'] and
              not native.gumballHandles() and (set(obj.Name for obj in doc.Objects),doc.UndoCount,doc.RedoCount,body.Placement,tip.Placement,body.Tip)==body_internal_before)
        ui.select(body);baseline=world_shape(body);before_tip=(body.Tip,tip.Placement,tip.Length.Value)
        ui.numeric('MoveX','5');doc.recompute()
        check('Body Move transforms its actual Tip result once',body.Tip==tip and tip.getParentGeoFeatureGroup()==body and
              tip.Placement==before_tip[1] and same_shape(world_shape(body),baseline.transformGeometry(App.Placement(App.Vector(5,0,0),App.Rotation()).toMatrix())))
        doc.undo();doc.recompute();ui.settle();check('Body Move Undo restores final result and ownership',body.Tip==tip and same_shape(world_shape(body),baseline))
        ui.select(body);names={obj.Name for obj in doc.Objects};ui.numeric('MoveX','5',QtCore.Qt.AltModifier);doc.recompute()
        body_copy=next(obj for obj in Gui.Selection.getSelection() if obj.TypeId=='PartDesign::Body' and obj!=body)
        check('Body Alt Move copies its private Tip definition',body_copy.Tip!=tip and body_copy.Tip in body_copy.Group and body.Tip==tip and
              same_shape(world_shape(body),baseline) and same_shape(world_shape(body_copy),baseline.transformGeometry(App.Placement(App.Vector(5,0,0),App.Rotation()).toMatrix())))
        created={obj.Name for obj in doc.Objects}-names;doc.undo();doc.recompute();ui.settle()
        check('Body Alt Move Undo removes copied Body and its private Tip',all(doc.getObject(name) is None for name in created) and body.Tip==tip and tip in body.Group and same_shape(world_shape(body),baseline))
        ui.select(body);body_matrix=affine(native.gumballState()['frame']);expected=baseline.transformGeometry(body_matrix);names={obj.Name for obj in doc.Objects}
        ui.numeric('ScaleX','2');doc.recompute();body_result=assert_graph(doc,body,expected,'native Body final result')
        check('Body fallback Scale preserves Tip type dimensions and native ownership',body.Tip==tip and tip.Length.Value==3 and tip in body.Group and tip.TypeId=='PartDesign::AdditiveBox')
        created={obj.Name for obj in doc.Objects}-names;body_output_name=body_result.Name
        doc.undo();doc.recompute();ui.settle()
        check('Body fallback Scale Undo restores native Tip result and removes graph',all(doc.getObject(name) is None for name in created) and body.Tip==tip and tip in body.Group and body.Visibility and same_shape(world_shape(body),baseline))
        doc.redo();doc.recompute();ui.settle();body_result=doc.getObject(body_output_name)
        check('Body fallback Scale Redo restores exact affine result with original Tip',body_result.OM9GumballScaleSource==body and body.Tip==tip and same_shape(world_shape(body_result),expected))
        manifest.append({'source':body.Name,'output':body_result.Name,'matrix':list(body_matrix.A)})
        # A late native input edit can leave a stale, apparently correct Shape.
        # Verify the recipe's durable inputs again after report callbacks.
        late_source=doc.addObject('Part::Box','LateScaleInputSource');late_source.Length=3;late_source.Width=4;late_source.Height=5
        late_source.Placement.Rotation=App.Rotation(App.Vector(1,2,3),29);doc.recompute();ui.select(late_source)
        names={obj.Name for obj in doc.Objects};before=(doc.UndoCount,doc.RedoCount,late_source.Placement,late_source.Length.Value,late_source.Visibility)
        class LateScaleObserver:
            fired=False
            def slotChangedObject(self,obj,prop):
                if not self.fired and prop=='OM9GumballReport' and getattr(obj,'OM9GumballScaleSource',None)==late_source:
                    self.fired=True;obj.LinkedObject.XScale=3
        observer=LateScaleObserver();App.addDocumentObserver(observer);prior_transcript=ui.transcript()
        try:
            ui.numeric('ScaleX','2')
            rejection_state=native.gumballState();rejection_transcript=ui.transcript()[len(prior_transcript):]
            report['late_scale_rejection']={'state':rejection_state,'transcript':rejection_transcript}
        finally:App.removeDocumentObserver(observer)
        doc.recompute();ui.settle()
        check('late Scale factor callback aborts atomically despite stale matching Shape',observer.fired and {obj.Name for obj in doc.Objects}==names and
              (doc.UndoCount,doc.RedoCount,late_source.Placement,late_source.Length.Value,late_source.Visibility)==before and result_for(doc,late_source) is None and
              'changed during publication' in rejection_state.get('unresolved','')+' '+rejection_transcript)
        late_support_source=doc.addObject('Part::Box','LateSupportSource');late_support_source.Length=3;late_support_source.Width=4;late_support_source.Height=5
        late_support_source.Placement.Rotation=App.Rotation(App.Vector(1,2,3),29)
        late_support=doc.addObject('PartDesign::SubShapeBinder','LateSupportConsumer');late_support.Support=[(late_support_source,['Face1'])]
        doc.recompute();late_support.Visibility=False;late_support_source.Visibility=True;ui.select(late_support_source)
        names={obj.Name for obj in doc.Objects};before=(doc.UndoCount,doc.RedoCount,late_support_source.Placement,late_support_source.Length.Value,late_support_source.Visibility)
        class LateSupportObserver:
            fired=False
            def slotChangedObject(self,obj,prop):
                if not self.fired and prop=='OM9GumballReport' and getattr(obj,'OM9GumballScaleSource',None)==late_support_source:
                    self.fired=True;late_support.Support=[(late_support_source,['Face1'])]
        observer=LateSupportObserver();App.addDocumentObserver(observer);prior_transcript=ui.transcript()
        try:
            ui.numeric('ScaleX','2')
            rejection_state=native.gumballState();rejection_transcript=ui.transcript()[len(prior_transcript):]
            report['late_support_rejection']={'state':rejection_state,'transcript':rejection_transcript}
        finally:App.removeDocumentObserver(observer)
        doc.recompute();ui.settle()
        check('late external Support callback aborts atomically and restores original dependency',observer.fired and {obj.Name for obj in doc.Objects}==names and
              (doc.UndoCount,doc.RedoCount,late_support_source.Placement,late_support_source.Length.Value,late_support_source.Visibility)==before and
              late_support.Support[0][0]==late_support_source and result_for(doc,late_support_source) is None and
              'changed during publication' in rejection_state.get('unresolved','')+' '+rejection_transcript)
        # A copied native XLink keeps durable names but loses its resolved
        # pointer. Recreating an untouched Support target under the same name
        # must not satisfy the final dependency identity check.
        identity_source=doc.addObject('Part::Box','LateIdentitySource');identity_source.Length=3;identity_source.Width=4;identity_source.Height=5
        identity_source.Placement.Rotation=App.Rotation(App.Vector(1,2,3),29)
        identity_target=doc.addObject('Part::Box','UnselectedSupportTarget');identity_target.Length=2;identity_target.Width=3;identity_target.Height=4
        identity_target.Placement.Base=App.Vector(9,2,1)
        identity_support=doc.addObject('PartDesign::SubShapeBinder','IdentitySupportConsumer')
        identity_support.Support=[(identity_source,['Face1']),(identity_target,['Face1'])]
        doc.recompute();identity_target.Visibility=False;identity_support.Visibility=False;identity_source.Visibility=True;ui.select(identity_source)
        target_name=identity_target.Name;target_id=identity_target.ID
        original_identity_support=[(entry[0].Name,entry[0].ID,tuple(entry[1])) for entry in identity_support.Support]
        target_before=(identity_target.Placement,identity_target.Length.Value,identity_target.Width.Value,identity_target.Height.Value,identity_target.Visibility)
        names={obj.Name for obj in doc.Objects};baseline=world_shape(identity_source)
        before=(doc.UndoCount,doc.RedoCount,identity_source.Placement,identity_source.Length.Value,identity_source.Visibility)
        class SameNameSupportObserver:
            fired=False
            replacement_id=None
            def slotChangedObject(self,obj,prop):
                if not self.fired and prop=='OM9GumballReport' and getattr(obj,'OM9GumballScaleSource',None)==identity_source:
                    self.fired=True
                    doc.removeObject(target_name)
                    replacement=doc.addObject('Part::Box',target_name);self.replacement_id=replacement.ID
                    replacement.Placement=target_before[0];replacement.Length=target_before[1];replacement.Width=target_before[2];replacement.Height=target_before[3]
                    replacement.Visibility=target_before[4]
                    identity_support.Support=[(obj,['Face1']),(replacement,['Face1'])]
        observer=SameNameSupportObserver();App.addDocumentObserver(observer);prior_transcript=ui.transcript()
        try:
            ui.numeric('ScaleX','2')
            rejection_state=native.gumballState();rejection_transcript=ui.transcript()[len(prior_transcript):]
            report['same_name_support_rejection']={'original_id':target_id,'replacement_id':observer.replacement_id,
                  'state':rejection_state,'transcript':rejection_transcript}
        finally:App.removeDocumentObserver(observer)
        doc.recompute();ui.settle();restored_target=doc.getObject(target_name)
        check('same-name untouched Support replacement aborts and restores original identities',observer.fired and observer.replacement_id!=target_id and
              {obj.Name for obj in doc.Objects}==names and
              (doc.UndoCount,doc.RedoCount,identity_source.Placement,identity_source.Length.Value,identity_source.Visibility)==before and
              restored_target is not None and restored_target.ID==target_id and
              (restored_target.Placement,restored_target.Length.Value,restored_target.Width.Value,restored_target.Height.Value,restored_target.Visibility)==target_before and
              [(entry[0].Name,entry[0].ID,tuple(entry[1])) for entry in identity_support.Support]==original_identity_support and
              [entry[0] for entry in identity_support.Support]==[doc.getObject(name) for name,target_id,subnames in original_identity_support] and
              result_for(doc,identity_source) is None and same_shape(world_shape(identity_source),baseline) and
              'incoming dependency changed during publication' in rejection_state.get('unresolved','')+' '+rejection_transcript)
        # Presentation callbacks run after the first shape validation. Editing
        # a generated Part shape must still roll the complete gesture back.
        for normalized in (False,True):
            definition=doc.addObject('Part::Box','LateNormalizerDefinition' if normalized else 'LatePresentationSource')
            definition.Length=3;definition.Width=4;definition.Height=5
            if normalized:
                presentation_source=doc.addObject('App::Link','LateNormalizerSource');presentation_source.setLink(definition)
                presentation_source.LinkTransform=True;presentation_source.ScaleVector=App.Vector(2,1.5,.5)
                presentation_source.LinkPlacement=App.Placement(App.Vector(2,3,4),App.Rotation(App.Vector(1,2,3),29))
                definition.Visibility=False
            else:
                presentation_source=definition;presentation_source.Placement.Rotation=App.Rotation(App.Vector(1,2,3),29)
            doc.recompute();presentation_source.Visibility=True;ui.select(presentation_source)
            names={obj.Name for obj in doc.Objects};properties=set(presentation_source.PropertiesList)
            baseline=world_shape(presentation_source)
            before=(doc.UndoCount,doc.RedoCount,presentation_source.Placement,presentation_source.Visibility)
            class LatePresentationObserver:
                fired=False
                def slotChangedObject(self,view,prop):
                    if not self.fired and prop=='Visibility' and view is presentation_source.ViewObject and not view.Visibility:
                        result=result_for(doc,presentation_source)
                        if result is not None:
                            self.fired=True
                            helper=result.LinkedObject.Base.LinkedObject if normalized else result.LinkedObject
                            report.setdefault('late_presentation_observations',[]).append({'source':presentation_source.Name,'helper':helper.Name,'type':helper.TypeId})
                            helper.Shape=Part.makeBox(9,8,7)
            observer=LatePresentationObserver();Gui.addDocumentObserver(observer);prior_transcript=ui.transcript()
            try:
                ui.numeric('ScaleX','2')
                rejection_state=native.gumballState();rejection_transcript=ui.transcript()[len(prior_transcript):]
                report.setdefault('late_presentation_rejections',[]).append({'state':rejection_state,'transcript':rejection_transcript})
            finally:Gui.removeDocumentObserver(observer)
            doc.recompute();ui.settle()
            check('late '+('normalizer' if normalized else 'Scale')+' Shape callback aborts atomically after presentation',
                  observer.fired and {obj.Name for obj in doc.Objects}==names and set(presentation_source.PropertiesList)==properties and
                  (doc.UndoCount,doc.RedoCount,presentation_source.Placement,presentation_source.Visibility)==before and
                  same_shape(world_shape(presentation_source),baseline) and result_for(doc,presentation_source) is None and
                  'native graph geometry changed before commit' in rejection_state.get('unresolved','')+' '+rejection_transcript)
        # The native binder exception never grants access to immutable inputs
        # or user-protected read-only properties on other geometry consumers.
        protected_source=doc.addObject('Part::Box','ProtectedSource');protected_source.Placement.Rotation=App.Rotation(App.Vector(1,2,3),29)
        protected_binder=doc.addObject('PartDesign::SubShapeBinder','ProtectedBinder');protected_binder.Support=[(protected_source,['Face1'])]
        protected_binder.setPropertyStatus('Support','Immutable');doc.recompute();protected_binder.Visibility=False;protected_source.Visibility=True
        ui.select(protected_source);names={obj.Name for obj in doc.Objects};before=(doc.UndoCount,doc.RedoCount,protected_source.Placement,protected_source.Length.Value)
        prior_transcript=ui.transcript();ui.numeric('ScaleX','2')
        rejection=native.gumballState().get('unresolved','')+' '+ui.transcript()[len(prior_transcript):];doc.recompute()
        check('immutable native Support rejects before transaction and retains protection',{obj.Name for obj in doc.Objects}==names and
              (doc.UndoCount,doc.RedoCount,protected_source.Placement,protected_source.Length.Value)==before and
              protected_binder.Support[0][0]==protected_source and 'Immutable' in protected_binder.getPropertyStatus('Support') and
              'read only' in rejection)
        protected_binder.setPropertyStatus('Support','-Immutable');protected_binder.Support=[]
        protected_cut=doc.addObject('Part::Cut','ProtectedCut');protected_cut.Base=protected_source;protected_cut.Tool=tool
        protected_cut.setEditorMode('Base',1);doc.recompute();protected_cut.Visibility=False;protected_source.Visibility=True
        ui.select(protected_source);names={obj.Name for obj in doc.Objects};before=(doc.UndoCount,doc.RedoCount,protected_source.Placement,protected_source.Length.Value)
        prior_transcript=ui.transcript();ui.numeric('ScaleX','2')
        rejection=native.gumballState().get('unresolved','')+' '+ui.transcript()[len(prior_transcript):];doc.recompute()
        check('ordinary read-only dependency rejects without clearing its protection',{obj.Name for obj in doc.Objects}==names and
              (doc.UndoCount,doc.RedoCount,protected_source.Placement,protected_source.Length.Value)==before and protected_cut.Base==protected_source and
              'ReadOnly' in protected_cut.getPropertyStatus('Base') and 'read only' in rejection)
        geometry_source=doc.addObject('Part::Box','GeometryExpressionSource');geometry_source.Length=3
        geometry_source.Placement.Rotation=App.Rotation(App.Vector(1,2,3),29)
        geometry_consumer=doc.addObject('Part::Box','GeometryExpressionConsumer')
        geometry_consumer.setExpression('Placement.Base.x','GeometryExpressionSource.Length')
        doc.recompute();geometry_consumer.Visibility=False;geometry_source.Visibility=True;ui.select(geometry_source)
        names={obj.Name for obj in doc.Objects};before=(doc.UndoCount,doc.RedoCount,geometry_source.Placement,geometry_source.Length.Value,geometry_consumer.ExpressionEngine)
        prior_transcript=ui.transcript();ui.numeric('ScaleX','2')
        rejection=native.gumballState().get('unresolved','')+' '+ui.transcript()[len(prior_transcript):];doc.recompute()
        check('expression governed Placement consumers reject explicitly before publication',
              {obj.Name for obj in doc.Objects}==names and
              (doc.UndoCount,doc.RedoCount,geometry_source.Placement,geometry_source.Length.Value,geometry_consumer.ExpressionEngine)==before and
              'expression governed geometry' in rejection)
        doc.saveAs(str(out/'associative-scale.FCStd'))
        (out/'cold-manifest.json').write_text(json.dumps(manifest,indent=2))
        report['saved']=str(out/'associative-scale.FCStd');report['ok']=True
    except Exception:
        report['ok']=False;report['error']=traceback.format_exc()
        if 'ui' in locals():
            report['failure_state']=native.gumballState();report['failure_transcript']=ui.transcript()
        if doc is not None:
            report['failure_objects']=[{'name':obj.Name,'type':obj.TypeId,'state':list(obj.State),
                  'members':[member.Name for member in getattr(obj,'Group',[])],
                  'source':getattr(getattr(obj,'OM9GumballScaleSource',None),'Name',None),
                  'linked':getattr(getattr(obj,'LinkedObject',None),'Name',None)} for obj in doc.Objects]
    finally:
        (out/'results.json').write_text(json.dumps(report,indent=2),encoding='utf-8')
        if doc is not None:App.closeDocument(doc.Name)
        QtCore.QTimer.singleShot(100,QtWidgets.QApplication.quit)
QtCore.QTimer.singleShot(1500,run)
