              not same_shape(shifted_y_cavity,cut_expected) and not same_shape(shifted_x_cavity,cut_expected))
        check('closed-solid oracle rejects a missing cavity',not closed_solid_equivalent(missing_cavity,cut_expected) and not same_shape(missing_cavity,cut_expected))
        check('selected Boolean definition remains connected to the original source',cut.Base==cut_source and cut.Tool==cut_tool and cut_source.Length.Value==3)
        for original,output in ((cut_source,cut_source_result),(cut,cut_result)):
            manifest.append({'source':original.Name,'output':output.Name,'matrix':list(cut_matrix.A)})
        # Alt on an ordinary group and a nested Part creates private copied
        # membership while preserving the complete original hierarchy.
        for geo in (False,True):
            copied_root=doc.addObject('App::Part' if geo else 'App::DocumentObjectGroup','AltNestedPart' if geo else 'AltOrdinaryGroup')
            copied_parent=None;unselected_sibling=None;baseline_sibling=None
            if geo:
                copied_parent=doc.addObject('App::Part','AltOuterPart');copied_parent.addObject(copied_root)
                copied_parent.Placement=App.Placement(App.Vector(7,-11,3),App.Rotation(App.Vector(2,3,1),19))
                copied_root.Placement=App.Placement(App.Vector(-4,5,2),App.Rotation(App.Vector(3,1,2),31))
                unselected_sibling=doc.addObject('Part::Box','AltUnselectedOuterSibling')
                unselected_sibling.Length=2;unselected_sibling.Width=3;unselected_sibling.Height=4
                unselected_sibling.Placement.Base=App.Vector(-8,1,0);copied_parent.addObject(unselected_sibling)
            grouped_box=doc.addObject('Part::Box','AltGroupedBox');grouped_box.Length=3;grouped_box.Width=4;grouped_box.Height=5
            grouped_box.Placement=App.Placement(App.Vector(1,2,3),App.Rotation(App.Vector(1,2,3),29))
            grouped_cylinder=doc.addObject('Part::Cylinder','AltGroupedCylinder');grouped_cylinder.Radius=2;grouped_cylinder.Height=4
            grouped_cylinder.Placement=App.Placement(App.Vector(11,2,3),App.Rotation(App.Vector(3,2,1),23))
            copied_root.addObject(grouped_box);copied_root.addObject(grouped_cylinder);doc.recompute()
            grouped_occurrence=None
            if geo:
                grouped_definition=doc.addObject('Part::Box','AltGroupedOccurrenceDefinition');grouped_definition.Length=3;grouped_definition.Width=2;grouped_definition.Height=4
                grouped_definition.Placement=App.Placement(App.Vector(2,-1,3),App.Rotation(App.Vector(1,2,3),17))
                grouped_occurrence=doc.addObject('App::Link','AltGroupedOccurrence');grouped_occurrence.setLink(grouped_definition)
                grouped_occurrence.LinkTransform=True;grouped_occurrence.ScaleVector=App.Vector(2,1.5,.5)
                grouped_occurrence.LinkPlacement=App.Placement(App.Vector(7,-2,3),App.Rotation(App.Vector(3,2,1),29))
                copied_root.addObject(grouped_occurrence);doc.recompute();grouped_definition.Visibility=False
            group_diagnostic={'geo':geo,'initial_visibility':{'root':copied_root.Visibility,'box':grouped_box.Visibility,
                  'cylinder':grouped_cylinder.Visibility,'occurrence':grouped_occurrence.Visibility if grouped_occurrence is not None else None}}
            copied_root.Visibility=True
            if copied_parent is not None:copied_parent.Visibility=True
            grouped_box.Visibility=True;grouped_cylinder.Visibility=True
            if grouped_occurrence is not None:grouped_occurrence.Visibility=True
            original_members=list(copied_root.Group);baseline_box=world_shape(grouped_box);baseline_cylinder=world_shape(grouped_cylinder)
            baseline_occurrence=world_shape(grouped_occurrence) if grouped_occurrence is not None else None
            if unselected_sibling is not None:baseline_sibling=world_shape(unselected_sibling)
            group_diagnostic['before']={'root':[copied_root.Name,copied_root.ID],
                  'members':[[obj.Name,obj.ID] for obj in original_members],'visibility':{'root':copied_root.Visibility,'box':grouped_box.Visibility,'cylinder':grouped_cylinder.Visibility},
                  'parent':None if copied_parent is None else {'name':copied_parent.Name,'id':copied_parent.ID,'placement':list(copied_parent.Placement.toMatrix().A),
                        'members':[[obj.Name,obj.ID] for obj in copied_parent.Group]},
                  'box':shape_facts(baseline_box),'cylinder':shape_facts(baseline_cylinder)}
            report.setdefault('alt_group_diagnostics',[]).append(group_diagnostic)
            ui.select(copied_root);group_matrix=affine(native.gumballState()['frame']);names={obj.Name for obj in doc.Objects};undo=doc.UndoCount
            group_diagnostic['before'].update({'undo':undo,'redo':doc.RedoCount,'selection':[[obj.Name,obj.ID] for obj in Gui.Selection.getSelection()]})
            no_resolve=Gui.Selection.getSelectionEx(doc.Name,0)
            group_diagnostic['before']['selection_no_resolve']=[{'object':entry.ObjectName,'subnames':list(entry.SubElementNames)} for entry in no_resolve]
            if geo:
                check('nested Part native selection identifies the child through its unselected outer owner',len(no_resolve)==1 and
