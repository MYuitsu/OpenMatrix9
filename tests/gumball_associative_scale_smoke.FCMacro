                      len(copied_parent.Group)==len(original_parent['members'])+1 and group_copy.getParentGeoFeatureGroup()==copied_parent and
                      unselected_sibling.getParentGeoFeatureGroup()==copied_parent and same_shape(world_shape(unselected_sibling),baseline_sibling) and
                      (unselected_sibling.Length.Value,unselected_sibling.Width.Value,unselected_sibling.Height.Value)==(2,3,4))
                normalizer=occurrence_copy.LinkedObject.Base.LinkedObject;bridge=occurrence_bridge(normalizer,grouped_occurrence)
                check('Alt copied nested Part privately owns the native occurrence normalizer and preserves source geometry',
