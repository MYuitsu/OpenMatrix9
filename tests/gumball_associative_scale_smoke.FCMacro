            box_copy=assert_graph(doc,grouped_box,baseline_box.transformGeometry(group_matrix),'Alt grouped rotated Box',False)
            cylinder_copy=assert_graph(doc,grouped_cylinder,baseline_cylinder.transformGeometry(group_matrix),'Alt grouped rotated Cylinder',False)
            occurrence_copy=assert_graph(doc,grouped_occurrence,baseline_occurrence.transformGeometry(group_matrix),'Alt grouped scaled occurrence',False) if grouped_occurrence is not None else None
            copy_parent=group_copy.getParentGeoFeatureGroup()
            group_diagnostic['after']={'copy':[group_copy.Name,group_copy.ID],'copy_members':[[obj.Name,obj.ID] for obj in group_copy.Group],
                  'copy_parent':None if copy_parent is None else {'name':copy_parent.Name,'id':copy_parent.ID,'members':[[obj.Name,obj.ID] for obj in copy_parent.Group]},
                  'original_members':[[obj.Name,obj.ID] for obj in copied_root.Group],
                  'box_output':[box_copy.Name,box_copy.ID],'cylinder_output':[cylinder_copy.Name,cylinder_copy.ID],
                  'visibility':{'root':copied_root.Visibility,'box':grouped_box.Visibility,'cylinder':grouped_cylinder.Visibility},
