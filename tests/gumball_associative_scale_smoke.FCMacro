            group_diagnostic['immediate_after']={'state':native.gumballState(),'undo':doc.UndoCount,'redo':doc.RedoCount,
                  'visibility':{'root':copied_root.Visibility,'box':grouped_box.Visibility,'cylinder':grouped_cylinder.Visibility},
                  'members':[[obj.Name,obj.ID] for obj in copied_root.Group]}
