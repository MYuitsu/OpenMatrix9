+struct Derivatives {
+    gp_Vec u,v,uu,vv,uv,normal;
+    Derivatives(const occ::handle<Geom_Surface>& surface,double a,double b) {
+        gp_Pnt point;surface->D2(a,b,point,u,v,uu,vv,uv);normal=u.Crossed(v);
