+    unsafe {
+        assert_eq!(
+            om9_phase3_request_begin(std::ptr::null(), 1, std::ptr::null(), 1),
+            0
+        );
+        assert_eq!(
+            om9_phase3_request_begin(b"D".as_ptr(), 1, std::ptr::null(), 257),
