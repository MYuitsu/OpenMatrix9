+        );
+        let huge = [SnapshotView {
+            identity: std::ptr::null(),
+            identity_len: usize::MAX,
+            signature: std::ptr::null(),
+            signature_len: 0,
+        }];
+        assert_eq!(
+            om9_phase3_request_begin(b"D".as_ptr(), 1, huge.as_ptr(), 1),
+            0
+        );
+    }
+}
