+        return crate::spline_ffi::publish(Err("Invalid Uniform Loft rows".into()));
+    }
+    let xyz = unsafe { std::slice::from_raw_parts(xyz, count * 3) };
+    let points = xyz
+        .as_chunks::<3>()
+        .0
+        .iter()
+        .map(|p| [p[0], p[1], p[2]])
+        .collect::<Vec<_>>();
+    crate::spline_ffi::publish(crate::spline::uniform_net_interpolate(&points, closed))
